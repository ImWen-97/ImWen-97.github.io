---
import type { CollectionEntry } from 'astro:content'
import { getCategoryUrl, getTagUrl, trimExcerpt } from '@/lib/utils'
import { blogSearchContent } from '@/lib/search-records'
import { categoryForPost } from '@/lib/blog-categories'
import { readingMinutes } from '@/lib/post-utils'

interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props
const summary = trimExcerpt(post.data.excerpt ?? blogSearchContent(post.body ?? ''))
const category = categoryForPost(post)
const minutes = readingMinutes(post.body ?? '')
---
<article class="border-b border-base-300 py-6 first:pt-0">
  <div class="flex flex-wrap items-center gap-3 mb-3">
    {post.data.draft && <span class="pill">草稿预览</span>}
    {post.data.pinned && <span class="pill !bg-[#f1e1b8] !text-[#765918] !border-[#dec88f]">置顶</span>}
    <time datetime={post.data.date} class="text-xs text-base-content/50">{post.data.date}</time>
    <span class="text-xs text-base-content/50">{minutes} 分钟阅读</span>
    <a class="pill pill-link" href={getCategoryUrl(category)}>{category}</a>
    {post.data.tags.map(tag => <a class="tag-link" href={getTagUrl(tag)}>#{tag}</a>)}
  </div>
  <h3 class="text-xl font-semibold tracking-tight">
    <a class="hover:text-[#4478b3] no-underline" href={`/blog/${post.id}`}>{post.data.title}</a>
  </h3>
  {summary && <p class="section-desc text-sm mt-2">{summary}</p>}
</article>
