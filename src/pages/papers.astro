---
import Layout from '@/layouts/Layout.astro'
import { publications } from '@/data/cv'
---
<Layout title="Publications | Jingwen Zheng">
  <section class="page-head">
    <span class="eyebrow">Research / Publications</span>
    <h1 class="section-title mt-5">Publications</h1>
    <p class="section-desc mt-5">Published papers and publicly shareable manuscripts will appear here as they become available.</p>
  </section>
  <div class="py-12">
    {publications.length ? publications.map(p => (
      <article class="soft-card mb-5">
        <h2 class="text-xl font-semibold">{p.title}</h2><p class="text-sm text-base-content/70 mt-2">{p.authors}</p>
        <p class="text-sm mt-2">{p.journal} · {p.time}</p>
        {p.link && <a class="link-arrow inline-block mt-3" href={p.link}>Read publication →</a>}
      </article>
    )) : <div class="soft-card text-base-content/65">No publications are listed yet. Submitted work is not presented as an accepted publication.</div>}
  </div>
</Layout>
