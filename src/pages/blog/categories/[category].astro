---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'
import { getOrderedPublishedPosts } from '@/lib/blog-posts'
import BlogPostCard from '@/components/ui/BlogPostCard.astro'
import Layout from '@/layouts/Layout.astro'
import { categoryForPost, listBlogCategories } from '@/lib/blog-categories'

export const getStaticPaths = (async () => {
  const posts = await getOrderedPublishedPosts()
  const categories = listBlogCategories(posts)
  return categories.map(category => ({
    params: { category },
    props: { category, posts: posts.filter(post => categoryForPost(post) === category) },
  }))
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>
const { category, posts } = Astro.props
---
<Layout title={`${category} | ArchEcho`}>
  <section class="page-head">
    <a class="link-arrow" href="/blog">← 全部文章</a>
    <h1 class="section-title mt-6">{category}</h1>
    <p class="section-desc mt-4">共 {posts.length} 篇文章</p>
  </section>
  <div class="max-w-[830px] grid gap-4 pt-9">
    {posts.map(post => <BlogPostCard post={post} />)}
    {posts.length === 0 && <p class="section-desc">这个分类还没有文章。在同名文件夹内新建 Markdown 文件，提交后会自动显示在这里。</p>}
  </div>
</Layout>
