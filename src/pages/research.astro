---
import Layout from '@/layouts/Layout.astro'
import { profile } from '@/settings'
---
<Layout title="Research | Jingwen Zheng" description="Research interests in GPU–PIM heterogeneous LLM inference, ReRAM reliability, and computer architecture.">
  <section class="page-head">
    <span class="eyebrow">Research / Directions</span>
    <h1 class="section-title mt-5">Researching what happens <span class="text-gradient">between layers.</span></h1>
    <p class="section-desc mt-6 text-lg">I am interested in how hardware constraints shape algorithms—and how application behavior can inform the design of efficient, reliable systems.</p>
  </section>
  <section class="py-14 grid gap-5">
    {profile.research_areas.map((area, index) => (
      <article class="soft-card">
        <div class="flex gap-6"><span class="text-2xl font-mono text-[#6291b1]">0{index + 1}</span><div><h2 class="text-2xl font-bold">{area.title}</h2><p class="section-desc mt-3">{area.description}</p></div></div>
      </article>
    ))}
  </section>
  <section class="py-10 border-t border-base-300">
    <h2 class="text-2xl font-bold">Questions I am exploring</h2>
    <ul class="mt-6 space-y-4 text-base-content/75 leading-8">
      <li>How can long-context LLM inference use limited PIM capacity effectively?</li>
      <li>When should memory-intensive operators run in PIM rather than on an xPU?</li>
      <li>How can hardware non-idealities be analyzed consistently across different ReRAM-mapped workloads?</li>
    </ul>
    <a href="/projects" class="link-arrow inline-block mt-8">Explore projects →</a>
  </section>
</Layout>
