---
import Layout from '@/layouts/Layout.astro'
import { projects } from '@/data/projects'
---
<Layout title="Projects | Jingwen Zheng" description="Research projects in reliable computing and LLM × PIM heterogeneous acceleration.">
  <section class="page-head">
    <span class="eyebrow">Selected Work / Projects</span>
    <h1 class="section-title mt-5">Projects and explorations.</h1>
    <p class="section-desc mt-6 text-lg">Research projects and ongoing questions at the intersection of emerging memory systems and AI workloads.</p>
  </section>
  <div class="py-13 grid gap-6">
    {projects.map((project, i) => (
      <article id={project.id} class="soft-card scroll-mt-28">
        <div class="flex flex-wrap justify-between items-center gap-4">
          <span class="eyebrow">Project 0{i + 1}</span>
          <span class="pill">{project.status}</span>
        </div>
        <h2 class="text-3xl font-bold tracking-tight mt-8">{project.name}</h2>
        <h3 class="text-lg text-base-content/80 mt-2">{project.subtitle}</h3>
        <p class="section-desc mt-5 max-w-[770px]">{project.description}</p>
        <div class="flex flex-wrap gap-2 mt-7">{project.tags.map(tag => <span class="text-xs border border-base-300 rounded-lg px-3 py-2 text-base-content/65">{tag}</span>)}</div>
        {project.link && <a href={project.link} class="link-arrow inline-block mt-7">View source →</a>}
      </article>
    ))}
  </div>
  <p class="text-sm text-base-content/50">More implementation details, code, and publications will be linked when publicly available.</p>
</Layout>
